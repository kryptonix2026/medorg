# ==============================================================================
# MedOrg Environment Configuration
# ==============================================================================

# Database & Mode
# Set DB_MODE to "local" (default SQLite) or "hosted" (Neon Postgres + S3)
DB_MODE=local
DATABASE_URL="file:../data/medorg.db"
# DIRECT_URL is required when using Neon Postgres for migrations / db push:
# DIRECT_URL="postgresql://user:password@ep-direct.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATA_DIR=../data

# Storage Driver: "disk" (local dev) or "s3" (Neon Object Storage)
STORAGE_DRIVER=disk
# S3 Configuration (automatically populated when using Neon Object Storage)
# S3_BUCKET_NAME=records
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://...
# AWS_REGION=us-east-2
# NEON_BRANCH=production
# ALLOW_PRODUCTION_RESET=false

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email (Brevo) Configuration
EMAIL_TRANSPORT=api
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=MedOrg
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Groq AI Configuration
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Security & Constraints
MAX_FILE_SIZE_MB=10
SESSION_DAYS=7
ENABLE_DB_VIEWER=true
ALLOW_DB_RESET=true
OTP_DEV_LOG=false